# Внешние материалы Track 1. В репозиторий они не кладутся намеренно:
# Model Y и официальный пакет расчёта ЧДД распространяются организаторами.
#
# Скопируйте этот файл в .env и укажите свои пути. Файл .env не отслеживается.
# Редактировать исходный код для этого не нужно.

# Корень колоды Model Y: каталог, в котором лежит MODEL_Y.DATA
MODEL_Y_ROOT=/path/to/model-y

# Корень официального пакета CHDD_PYTHON: каталог с chdd_model.py
CHDD_ROOT=/path/to/chdd-python

# Когнитивный провайдер MAS (вариант бенчмарка MAS ON). Без него специалисты
# работают детерминированно, и MAS ON просто не запускается.
# MAS_LLM_PROVIDER=anthropic            # anthropic | openai_compatible
# MAS_LLM_MODEL=<model-id>
# MAS_LLM_TIMEOUT_SECONDS=60
# MAS_LLM_TEMPERATURE=0                 # 0 -- повторяемый первый бенчмарк
# MAS_LLM_MAX_TOKENS=2048
# MAS_LLM_BASE_URL=<override>           # напр. Gemini OpenAI-compat или локальный сервер
# MAS_LLM_STRUCTURED_OUTPUT=1           # просить схемой ограниченный JSON (openai_compatible)
# MAS_LLM_REASONING_EFFORT=low          # решение специалиста --небольшой JSON, а не эссе

# Ключ провайдера берётся из его документированной переменной и НЕ хранится в
# репозитории: ANTHROPIC_API_KEY или OPENAI_API_KEY.
