# Внешние материалы Track 1. В репозиторий они не кладутся намеренно:
# Model Y и официальный пакет расчёта ЧДД распространяются организаторами.
#
# Скопируйте этот файл в .env и укажите свои пути. Файл .env не отслеживается.
# Редактировать исходный код для этого не нужно.

# Корень колоды Model Y: каталог, в котором лежит MODEL_Y.DATA
MODEL_Y_ROOT=/path/to/model-y

# Корень официального пакета CHDD_PYTHON: каталог с chdd_model.py
CHDD_ROOT=/path/to/chdd-python
