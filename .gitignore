# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment
.venv/
.env
.env.*
# Пример настройки внешних материалов отслеживается намеренно.
!.env.example

# Build output
build/
dist/

# Generated project output
artifacts/
reports/
data/raw/
data/processed/
*.log
*.tmp

# Operating system
.DS_Store

# Validation pipeline run output
output/
runtime/

# Experiment run output
experiments/*/runtime/

# Simulator artifacts. Physical output is reproducible from the manifest and
# is far too heavy to belong in history; only compact summaries are tracked.
*.UNSMRY
*.SMSPEC
*.EGRID
*.UNRST
*.INIT
*.DBG
*.PRT
*.ESMRY

# Benchmark run output. Workspaces live outside the repository by default;
# this keeps an accidental in-tree run from being committed.
benchmark-results/
benchmark_workspace/
